{
    "name": "youtube-movie-maker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "dev:api": "cd video_editor && python -m uvicorn api.main:app --reload --port 8502",
        "dev:video-editor": "cd video_editor && streamlit run app.py",
        "dev:all": "npm run dev & npm run dev:api",
        "slides:render": "node slides/cli.mjs --spec slides/spec.yml --out out/slides",
        "slides:render:example": "node slides/cli.mjs --spec slides/examples/basic.yml --out out/slides_example",
        "test:slides": "node --test tests/slides.spec.mjs",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.1",
        "@aws-sdk/client-s3": "^3.948.0",
        "@aws-sdk/s3-request-presigner": "^3.948.0",
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^5.22.0",
        "@types/archiver": "^7.0.0",
        "@resvg/resvg-js": "^2.6.2",
        "archiver": "^7.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.23.25",
        "lucide-react": "^0.460.0",
        "next": "14.2.15",
        "next-auth": "^4.24.13",
        "react": "^18",
        "react-dom": "^18",
        "resend": "^6.6.0",
        "satori": "^0.18.3",
        "sonner": "^2.0.7",
        "stripe": "^20.1.0",
        "tailwind-merge": "^2.6.0",
        "uuid": "^10.0.0",
        "yaml": "^2.6.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@types/uuid": "^10.0.0",
        "autoprefixer": "^10.4.22",
        "eslint": "^8",
        "eslint-config-next": "14.2.15",
        "postcss": "^8",
        "prisma": "^5.22.0",
        "tailwindcss": "^3.4.1",
        "typescript": "^5"
    }
}
